{
  "name": "yap-machine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x"
  },
  "cloudflare": {
    "bindings": {
      "SUPABASE_URL": {
        "description": "The Supabase project URL, https://<ref>.supabase.co."
      },
      "SUPABASE_SECRET_KEY": {
        "description": "A Supabase secret key (sb_secret_\u2026). Server only; the browser never talks to Supabase."
      },
      "YAP_AGENT_TOKEN": {
        "description": "Base64url of 32+ random bytes. The agent's bearer on /api/agent/*; the same value is the agent's YAP_AGENT_TOKEN secret."
      },
      "YAP_ORIGIN": {
        "description": "The Worker's public origin, for the origin check on every write."
      },
      "OPENCOMPUTER_API_KEY": {
        "description": "Optional. An OpenComputer API key for the organization that owns project yap-machine; without it learning runs are not started."
      },
      "YAP_AGENT_REF": {
        "description": "Required with OPENCOMPUTER_API_KEY: the agent as <agent id>@<environment>, e.g. yap-machine@development."
      },
      "YAP_DAILY_X_SPEND_USD": {
        "description": "Optional, default 25. The daily X API spend cap in USD."
      },
      "YAP_SCORE_THRESHOLD": {
        "description": "Optional, default 60. Posts scoring at or above it are Open; below it, Filtered."
      }
    }
  },
  "scripts": {
    "dev": "vite dev --port 3300 --strictPort",
    "dev:local": "tsx dev/local/run.ts",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p opencomputer/tsconfig.json",
    "lint": "biome check --config-path dev/biome.config.json .",
    "format": "biome format --config-path dev/biome.config.json --write .",
    "test": "vitest run --config dev/vitest.config.ts",
    "test:e2e": "playwright test --config dev/playwright.config.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "scout:once": "tsx scripts/scout-once.ts",
    "seed:brief": "tsx scripts/seed-brief.ts",
    "doctor": "cd opencomputer && opencomputer doctor",
    "deploy:agents": "cd opencomputer && opencomputer deploy --alias development"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@opencomputer/sdk": "2.1.2",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-start": "1.168.54",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.46.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@cloudflare/vite-plugin": "1.54.10",
    "@electric-sql/pglite": "0.5.8",
    "@opencomputer/agent": "0.7.5",
    "@opencomputer/cli": "0.7.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "json-schema-to-ts": "3.1.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.132.0"
  }
}
