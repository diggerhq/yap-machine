# The Worker's configuration. Copy to .env.local for `npm run dev`; deployed,
# each is a Worker secret (npx wrangler secret put <NAME>).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
YAP_AGENT_TOKEN=
YAP_ORIGIN=http://localhost:3300
# Optional
OPENCOMPUTER_API_KEY=
YAP_AGENT_REF=yap-machine@development
YAP_DAILY_X_SPEND_USD=25
YAP_SCORE_THRESHOLD=60
