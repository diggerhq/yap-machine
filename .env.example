# The app's configuration. `cp .env.example .env.local` and fill it in.
# `npm run setup` adds YAP_AGENT_TOKEN.

# Your ngrok domain (ngrok dashboard → Domains; free accounts get one): the
# fixed public address the agent, which runs in the cloud, reaches the app at.
YAP_PUBLIC_ORIGIN=

# An API key for your OpenComputer organization (dashboard). The app and
# `npm run scout:once` use it to start the agent's runs.
OPENCOMPUTER_API_KEY=

# Optional: a hosted Supabase project. Unset, the app uses a local database
# (PGlite, kept in dev/local/.pglite) and needs no database account.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: the score a post needs to reach Open (default 60).
YAP_SCORE_THRESHOLD=60
