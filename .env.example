# The app's configuration. `cp .env.example .env.local`, then fill in what
# you use. `npm run dev` reads this file and writes YAP_AGENT_TOKEN into it.

# Required to start scout runs (npm run scout:once) and learning runs:
# an API key for your OpenComputer organization, from the dashboard.
OPENCOMPUTER_API_KEY=

# Optional: a hosted Supabase project. Unset, the app uses a local database
# (PGlite, under dev/local/.pglite) and needs no database account.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional, with defaults.
YAP_DAILY_X_SPEND_USD=25
YAP_SCORE_THRESHOLD=60
